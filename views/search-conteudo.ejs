<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscando - Zyn Library</title>
    <link rel="stylesheet" href="/style/style.css">
</head>
<body>
    <header>
        <a href="/">
            <h1>Zyn Library</h1>
        </a>
        <div class="login-info">
            <% if (loginInfo) { %>
                <span class="name"><%= loginInfo.nome %></span>
                <span class="username">@<%= loginInfo.usuario %></span>
            <% } %>
        </div>
    </header>
    <main>
        <h2 class="page-title"><%=conteudos[0].topico%></h2>
        <div class="container search-container">
            <% conteudos.forEach((conteudo) => { %>
                <a class="search-card option-card" href="/read/<%=conteudo.id_conteudo%>">
                    <p class="title"><%=conteudo.titulo%></p>
                    <!-- <p class="topic"><%=conteudo.topico%></p> -->
                    <p class="author">Por: <%=conteudo.autor%></p>
                </a>
            <% }) %>

        </div>
    </main>
    <footer><a href="https://github.com/joaopedrov0">@joaopedrov0</a></footer>
</body>
</html>