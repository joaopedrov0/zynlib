<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Criação de conteúdo - Zyn Library</title>
    <link rel="stylesheet" href="/style/style.css">
</head>
<body>
    <header>
        <a href="/">
            <h1>Zyn Library</h1>
        </a>
    </header>
    <main>
        <div class="container">
            <h2>Criação de Conteúdo</h2>
            <form action="/create-content" method="POST">
                <div class="topic-box">
                    <select name="topic" id="topic">
                        <option value="" disabled selected>Selecione o tópico</option>
                        <% topics.forEach((topic) => { %>
                            <a class="search-card" href="/search/<%=dataUnit.id_area%>">
                                <p class="title"><%=topic.nome%></p>
                            </a>
                            <option value="<%=topic.id_topico%>"></option>
                        <% }) %>
                    </select>
                </div>
                <div class="keyword">
                    <select name="keywords" id="keywords">
                        <option value="" disabled selected>Selecione palavras-chave</option>
                    </select>
                    <input type="text" name="newKeyword" id="newKeyword" placeholder="Digite aqui uma nova palavra chave">
                </div>
                <div class="content-box"></div>
                <div class="external-material"></div>
            </form>
        </div>
    </main>
    <footer><a href="https://github.com/joaopedrov0">@joaopedrov0</a></footer>
</body>
</html>