<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buscando - Zyn Library</title>
    <link rel="stylesheet" href="/style/style.css">
    
    <script src="https://cdn.jsdelivr.net/npm/easymde/dist/easymde.min.js" defer></script>
</head>
<body>
    <header>
        <a href="/">
            <h1>Zyn Library</h1>
        </a>
        <div class="login-info">
            <% if (loginInfo) { %>
                <span class="name"><%= loginInfo.nome %></span>
                <span class="username">@<%= loginInfo.usuario %></span>
            <% } %>
        </div>
    </header>
    <main>
        <h2 class="page-title">Áreas do conhecimento</h2>
        <div class="container">
            <h2><%=conteudo.nome%></h2>
            <div class="conteudo-box">

            </div>
        </div>
    </main>
    <footer><a href="https://github.com/joaopedrov0">@joaopedrov0</a></footer>
    <script src="https://cdn.jsdelivr.net/npm/markdown-it/dist/markdown-it.min.js"></script>
    <script>
        const content = `<%-conteudo.conteudo_markdown%>`
        const md = window.markdownit();
        const html = md.render(content);
        const conteudoHTML = document.querySelector('.conteudo-box')
    conteudoHTML.innerHTML = html
    </script>
</body>
</html>