<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cadastro - Zyn Library</title>
    <link rel="stylesheet" href="/style/style.css">
</head>
<body>
    <header>
        <a href="/">
            <h1>Zyn Library</h1>
        </a>
    </header>
    <main>
        <div class="container">
            <form action="/register" method="POST">
                <input type="text" name="nome" placeholder="Digite seu nome">
                <input type="text" name="username" placeholder="Digite seu username (único)">
                <input type="password" name="senha" placeholder="Digite sua senha">
                <button type="submit">Cadastro</button>
            </form>
        </div>
    </main>
    <footer><a href="https://github.com/joaopedrov0">@joaopedrov0</a></footer>
</body>
</html>